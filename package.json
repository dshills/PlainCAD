{
  "name": "plaincad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b --noEmit && tsc -p tsconfig.e2e.json",
    "release:check": "npm run lint && npm test && npm run build && npm run test:browser && npm run test:production",
    "test:browser": "playwright test",
    "preview": "vite preview",
    "test:production": "playwright test -c playwright.production.config.ts",
    "test:ai:browser": "playwright test -c playwright.ai.config.ts",
    "test:ai:live": "playwright test -c playwright.ai-live.config.ts",
    "test:cross-browser": "npm run build && playwright test -c playwright.cross-browser.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "opencascade.js": "^1.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
